{
  "name": "auto-redact",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cli": "tsx src/cli.ts",
    "api": "tsx src/server.ts",
    "prepare": "husky"
  },
  "license": "GPL-3.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'npx tsc -b'",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "canvas": "^3.2.3",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "fastify": "^5.9.0",
    "jspdf": "^4.0.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2"
  },
  "overrides": {
    "cross-spawn": ">=7.0.5",
    "glob": ">=10.5.0",
    "minimatch": ">=9.0.7",
    "tar": ">=7.5.11"
  }
}
